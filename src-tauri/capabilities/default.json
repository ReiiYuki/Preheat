{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "fs:default",
    "os:default",
    "fs:allow-app-data-read",
    "fs:allow-app-data-write",
    "fs:allow-app-data-mkdir",
    "fs:allow-app-config-read",
    "fs:allow-app-config-write",
    "fs:allow-app-config-mkdir",
    "fs:allow-exists"
  ]
}